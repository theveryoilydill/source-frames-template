{
	"include": ["vite.config.ts", "react-router.config.ts"],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"lib": ["ES2022"],
		"types": ["node"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	}
}
